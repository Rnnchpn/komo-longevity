// Optional local override for Pulse iOS client configuration.
// Copy this file to Secrets.xcconfig only when targeting another Supabase environment.
// Never place service_role or secret keys in an iOS client.
// SLASH is defined in Base.xcconfig because a literal // is parsed as a comment delimiter by xcconfig.

SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
