// Shared Pulse iOS build settings.
// KŌMØ Pulse uses the production Supabase project by default so a clean checkout can launch.
// The publishable key below is a client-side key by design; never place service_role or secret keys here.
// Secrets.xcconfig can still override these values locally for another environment.

PRODUCT_BUNDLE_IDENTIFIER = com.komolongevity.pulse
PRODUCT_NAME = Pulse
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0
PULSE_URL_SCHEME = com.komolongevity.pulse
PULSE_AUTH_REDIRECT_URL = $(PULSE_URL_SCHEME)://auth/callback

SUPABASE_URL = https://uqlolefsiktbznnymriy.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_3sUsinfJ_nMFI44OXozkKQ_jmGG8w7n
